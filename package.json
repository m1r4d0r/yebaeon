{
  "name": "yebaeon",
  "version": "0.2.0",
  "private": true,
  "description": "YebaeOn Studio and PP6 Sync tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "5.20260926.1-alpha",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "cfb": "1.2.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.2"
  }
}
